# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# PostgreSQL credentials used by both the db and api containers.
POSTGRES_USER=ims
POSTGRES_PASSWORD=

# JWT signing key. MUST be at least 32 characters or the API refuses to start.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Optional. Leave blank and the seeder generates a random administrator password
# and logs it once on first start — read it from the container logs.
SEED_ADMIN_PASSWORD=
